{
  "name": "gold-market-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "prebuild:pages": "node checks/pages-artifact.mjs --snapshot-only",
    "preview:pages": "vite preview --mode pages --host 127.0.0.1 --port 4173 --strictPort --base=/pages-preview/",
    "check:pages": "node checks/pages-check.mjs",
    "check:axes": "node checks/axis-check.mjs",
    "check:price": "node checks/price-check.mjs",
    "check:ui": "node checks/ui-check.mjs"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "playwright": "^1.64.1",
    "vite": "^7.0.0"
  }
}
