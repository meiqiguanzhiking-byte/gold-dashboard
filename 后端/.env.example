# 复制为同目录.env，填入密钥，重启后端后自动读取；不要提交真实.env。
# 系统/进程中已有的同名环境变量优先。DeepSeek缺少密钥时只显示数值规则。
GOLD_REPORT_AI_URL=https://api.deepseek.com/chat/completions
GOLD_REPORT_AI_MODEL=deepseek-flash
GOLD_REPORT_AI_KEY=
GOLD_REPORT_AI_TIMEOUT=60
# 每日最多5次；输入+输出合计15000，输出额度由剩余预算计算，可在此进一步调低。
GOLD_REPORT_AI_MAX_TOKENS=15000
# Node需支持Array.toSorted/findLast；推荐Node 24。可指定绝对路径。
GOLD_REPORT_NODE=node
